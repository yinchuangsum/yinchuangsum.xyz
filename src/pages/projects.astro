---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const commercial = projects.filter((p) => p.data.category === "commercial");
const openSource = projects.filter((p) => p.data.category === "open-source");
---

<BaseLayout title="Projects — Yin Chuang Sum">
  <section class="section hero">
    <div class="container hero-center">
      <p class="eyebrow">PROJECTS</p>
      <h1>Things I've built.</h1>
      <p class="lead">
        A mix of commercial products, open source tools, and side experiments.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="margin-bottom: var(--gap-xl);">
        <p class="eyebrow">COMMERCIAL</p>
        <h2>Closed source.</h2>
      </div>
      <div class="grid-2">
        {commercial.map((p) => (
          <ProjectCard
            title={p.data.title}
            subtitle={p.data.subtitle}
            description={p.data.description}
            badge={p.data.badge}
            href={p.data.href}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="margin-bottom: var(--gap-xl);">
        <p class="eyebrow">OPEN SOURCE</p>
        <h2>Built in public.</h2>
      </div>
      <div class="grid-2">
        {openSource.map((p) => (
          <ProjectCard
            title={p.data.title}
            subtitle={p.data.subtitle}
            description={p.data.description}
            badge={p.data.badge}
            href={p.data.href}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
