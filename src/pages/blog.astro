---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogRow from "../components/LogRow.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title="Blog — Yin Chuang Sum">
  <section class="section hero">
    <div class="container hero-center">
      <p class="eyebrow">TECHNICAL BLOG</p>
      <h1>Writing about what I build.</h1>
      <p class="lead">
        Deep dives on software architecture, engineering practices, and
        the tools that power modern products. All posts written by hand —
        no AI involved.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="search-bar">
        <input id="blog-search" class="input" type="text" placeholder="Search articles, topics, tags..." />
        <button id="blog-search-btn" class="btn btn-secondary">Search</button>
      </div>

      <div class="row-between" style="margin-bottom: var(--gap-lg);">
        <h2>Latest articles</h2>
        <div class="tag-cluster" id="blog-tags">
          <span class="tag active" data-tag="">All</span>
          {allTags.map((tag) => (
            <span class="tag" data-tag={tag.toLowerCase()}>{tag}</span>
          ))}
        </div>
      </div>

      <div id="blog-posts">
        {posts.length > 0 ? (
          posts.map((post) => {
            const slug = post.id.replace(/\.(md|mdx)$/, "");
            return (
              <LogRow
                date={post.data.date.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
                title={post.data.title}
                description={post.data.description}
                tags={post.data.tags}
                readTime={post.data.readTime}
                href={`/blog/${slug}`}
              />
            );
          })
        ) : (
          <p class="meta" style="text-align: center; padding-block: var(--gap-2xl); font-size: 15px;">
            No posts yet.
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sub-block" style="text-align: center;">
        <p class="meta" style="font-size: 15px; color: var(--muted);">
          Newsletter & RSS — coming soon.
        </p>
      </div>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById("blog-search") as HTMLInputElement | null;
    const searchBtn = document.getElementById("blog-search-btn") as HTMLElement | null;
    const tags = document.querySelectorAll("#blog-tags .tag");
    const postsContainer = document.getElementById("blog-posts") as HTMLElement | null;

    function filterPosts() {
      if (!postsContainer || !searchInput) return;

      const query = searchInput.value.trim().toLowerCase();
      const activeTag = document.querySelector("#blog-tags .tag.active");
      const tag = activeTag?.getAttribute("data-tag") || "";

      const rows = postsContainer.querySelectorAll(".log-row");
      let visibleCount = 0;

      rows.forEach((row) => {
        const text = (row as HTMLElement).textContent?.toLowerCase() || "";
        const rowTags = row.querySelectorAll(".tag");
        const rowTagValues = Array.from(rowTags).map((t) => t.textContent?.trim().toLowerCase() || "");

        const matchesSearch = !query || text.includes(query);
        const matchesTag = !tag || rowTagValues.includes(tag);

        (row as HTMLElement).style.display = matchesSearch && matchesTag ? "" : "none";
        if (matchesSearch && matchesTag) visibleCount++;
      });

      const empty = postsContainer.querySelector(".empty-state") as HTMLElement | null;
      if (empty) {
        empty.style.display = visibleCount === 0 ? "" : "none";
      }
    }

    searchInput?.addEventListener("input", filterPosts);
    searchBtn?.addEventListener("click", filterPosts);

    tags.forEach((tag) => {
      tag.addEventListener("click", () => {
        const wasActive = tag.classList.contains("active");
        tags.forEach((t) => t.classList.remove("active"));
        if (!wasActive) tag.classList.add("active");
        else (document.querySelector("#blog-tags .tag[data-tag='']") as HTMLElement | null)?.classList.add("active");
        filterPosts();
      });
    });
  </script>
</BaseLayout>
